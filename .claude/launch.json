{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "zsh",
      "runtimeArgs": [
        "-c",
        "export NVM_DIR=\"$HOME/.nvm\"; . \"$NVM_DIR/nvm.sh\"; npm run dev -- --port \"${PORT:-5173}\" --strictPort"
      ],
      "port": 5173,
      "autoPort": true
    }
  ]
}
