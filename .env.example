# Copy to .env.local and fill in from your Supabase project.
#
# Easiest source: the "Connect" button at the top of the project dashboard ->
# App Frameworks -> React / Vite. Paste the block it gives you.
#
# Otherwise: Project Settings -> API Keys.
#
# Use ONE of the two key lines below, whichever your dashboard shows:
#   - New projects get a short `sb_publishable_...` key.
#   - Older ones get a long `eyJ...` anon JWT.
# Never put the `service_role` / `sb_secret_...` key here - it bypasses every
# Row-Level Security rule and this file is bundled into the browser.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here
# VITE_SUPABASE_ANON_KEY=your-anon-public-key

# No service-role key belongs in any VITE_ variable. MFA and school membership
# are discovered from the authenticated Supabase session; no school ID is
# trusted from client-side environment variables.
